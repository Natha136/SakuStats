<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_transaction_card"
    android:clickable="true"
    android:elevation="4dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="20dp">

    <!-- Left: title + subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_transaction_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:text="Cozy Morning Latte"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_transaction_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/quicksand_regular"
            android:text="08:45 AM • Starbucks"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Right: amount + type -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_transaction_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="end"
            android:letterSpacing="0.02"
            android:text="- Rp 45.000"
            android:textColor="@color/color_expense"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_transaction_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_regular"
            android:gravity="end"
            android:text="Keluar"
            android:textColor="@color/color_text_muted"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
