<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/color_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/view_indicator"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_orange"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="Reminder Menabung"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_notif_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kamu belum menyisihkan uang hari ini."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_notif_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="12 Oct 2023, 10:00"
                android:textColor="@color/color_text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_notif_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_piggy"
            app:tint="@color/color_peach_dark" />

    </LinearLayout>
</androidx.cardview.widget.CardView>