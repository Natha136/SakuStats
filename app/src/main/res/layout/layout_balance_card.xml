<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="201dp"
    android:background="@drawable/bg_balance_card"
    android:clipToOutline="true"
    android:elevation="8dp">

    <!-- Decorative sparkle circle (top right) -->
    <View
        android:layout_width="456dp"
        android:layout_height="261dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-24dp"
        android:layout_marginEnd="-24dp"
        android:alpha="0.2"
        android:background="@drawable/bg_quick_action" />

    <!-- Piggy bank icon bottom right -->
    <ImageView
        android:id="@+id/iv_piggy"
        android:layout_width="50dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_piggy" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <!-- "Sisa Saldo" label -->
        <TextView
            android:id="@+id/tv_saldo_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:letterSpacing="0.05"
            android:text="@string/label_sisa_saldo"
            android:textColor="@color/color_text_brand_dark"
            android:textSize="14sp" />

        <!-- Balance amount -->
        <TextView
            android:id="@+id/tv_balance_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:text=""
            android:textColor="@color/color_text_brand_dark"
            android:textSize="40sp" />

        <!-- Income & Expense row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Pemasukan -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_regular"
                    android:letterSpacing="0.1"
                    android:text="@string/label_pemasukan"
                    android:textAllCaps="true"
                    android:textColor="#B3795E44"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_income_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:letterSpacing="0.05"
                    android:text=""
                    android:textColor="@color/color_text_brand_dark"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Vertical divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/color_divider" />

            <!-- Pengeluaran -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_regular"
                    android:letterSpacing="0.1"
                    android:text="@string/label_pengeluaran"
                    android:textAllCaps="true"
                    android:textColor="#B3795E44"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_expense_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:letterSpacing="0.05"
                    android:text=""
                    android:textColor="@color/color_text_brand_dark"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
